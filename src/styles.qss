/* ---------------------------
   GENERAL APPLICATION STYLES
---------------------------- */
QMainWindow {
    background-color: #466060;
    border-radius: 0px;
}

QDialog {
    border: 3px solid #1B2626;
    background-color: #8EA09F;
}

/* HEADERS  */
QLabel#header, QLabel#HEADER {
    qproperty-alignment: AlignCenter;
    background-color: #1B2626;
    color: white;
    font: bold 41px 'Arial';
    padding: 15px;
}

/* BUTTONS */
QPushButton {
    font: 15px 'Arial';
    background-color: #1B2626;
    padding: 10px 30px;
    border-radius: 0px;
    margin-top: 25px; /* consistent spacing for form buttons */
}

QPushButton:hover {
    background-color: #101717;
    padding: 8px 28px;
    border: 2px solid #1B2626;
}

/* INPUTS FIELDS */
QLineEdit, QDateEdit {
    background-color: white;
    color: black;
    border-radius: 0px;
    border: 3px solid #293737;
    padding: 5px;
}

QCalendar {
    background-color: white;
}

/* DIALOG POPUPS */
#popup QLabel {
    color: #1B2626;
    margin-bottom: 10px;
    padding: 15px;
}

#popup QPushButton {
    padding: 5px;
}

QListView {
    background-color: white;
    color: #1B2626;
    border: 3px solid #1B2626;
    font: bold 15px 'Arial';
}

QListView::item {
    border-bottom: 3px solid #1B2626;
    padding: 10px;
}


#DIVIDER {
    background-color: #1B2626;
}
